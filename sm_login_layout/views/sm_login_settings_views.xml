<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sm_login_settings_form" model="ir.ui.view">
        <field name="name">sm.login.settings.form</field>
        <field name="model">sm.login.settings</field>
        <field name="arch" type="xml">
            <form string="Login Layout">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="enabled"/>
                            <field name="design"/>
                            <field name="show_logo"/>
                        </group>
                        <group string="Appearance">
                            <field name="overlay_color"/>
                            <field name="overlay_opacity"/>
                            <field name="card_opacity"/>
                            <field name="blur"/>
                        </group>
                    </group>
                    <group string="Day and Night">
                        <field name="night_enabled"/>
                        <field name="night_start"/>
                        <field name="night_end"/>
                        <field name="slideshow_interval"/>
                    </group>
                    <field name="wallpaper_ids">
                        <list string="Wallpapers" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="image" widget="image" options="{'size': [90, 60]}"/>
                            <field name="moment"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                    <div class="text-muted mt-2">
                        The custom login covers the login, signup and reset password pages.
                        Add several wallpapers to run them as a slideshow, and mark some as Night
                        to switch them by the visitor local time.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sm_login_settings" model="ir.actions.server">
        <field name="name">Login Layout</field>
        <field name="model_id" ref="model_sm_login_settings"/>
        <field name="state">code</field>
        <field name="code">action = model._get_singleton().action_open_login_settings()</field>
    </record>

    <menuitem id="menu_sm_login_settings"
              name="Login Layout"
              parent="base.menu_administration"
              action="action_sm_login_settings"
              sequence="90"
              groups="base.group_system"/>
</odoo>
